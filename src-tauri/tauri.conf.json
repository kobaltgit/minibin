{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniBin",
  "version": "2.0.1",
  "identifier": "com.kobalt.minibin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "MiniBin",
        "label": "main",
        "width": 380,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/minibin-kt-empty.ico",
      "icons/minibin-kt-full.ico"
    ]
  }
}
